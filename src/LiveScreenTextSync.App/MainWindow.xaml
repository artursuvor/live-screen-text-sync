<Window x:Class="LiveScreenTextSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Screen Text Sync" Width="900" Height="760" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
 <Grid x:Name="LayoutViewport" Margin="28,24">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MinHeight="{Binding ActualHeight, ElementName=LayoutViewport}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="SCREEN → TEXT     /     LOCAL &amp; PRIVATE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
    <TextBlock Text="Live Screen Text Sync" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,4"/>
    <TextBlock Text="Read a screen region. Copy the text when you need it." Foreground="{StaticResource MutedBrush}"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#1F3430" CornerRadius="14" Padding="14,7" VerticalAlignment="Top" Margin="14,0,0,0">
    <TextBlock x:Name="StateLabel" Text="●  Idle" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
   </Border>
  </Grid>
  <Border Grid.Row="1" Margin="0,0,0,18" Style="{StaticResource Card}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
    <TextBlock Text="SOURCE REGION" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
    <TextBlock x:Name="SourceTitle" Text="Choose what to read" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,5"/>
    <TextBlock x:Name="SourceDetail" Text="Drag a rectangle within one monitor." Style="{StaticResource Caption}" TextWrapping="Wrap" MinHeight="34"/>
    </StackPanel>
    <Button x:Name="SourceButton" Grid.Column="1" Content="Select Source" Click="SelectSource_Click" VerticalAlignment="Center" Margin="20,0,0,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" MinHeight="170" Margin="0,0,0,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock Text="RECOGNIZED TEXT" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock Text="On-device OCR" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
    <Grid Grid.Row="1">
     <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="17" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Recognized text preview"/>
     <TextBlock x:Name="PreviewPlaceholder" Text="Your captured text will appear here.&#10;Select a source region, then press Start Capture." Foreground="#8194A6" FontSize="16" LineHeight="28" IsHitTestVisible="False"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,12,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock x:Name="FramesLabel" Text="0 frames" Style="{StaticResource Caption}"/>
     <TextBlock x:Name="UpdatesLabel" Grid.Column="1" Text="0 text changes" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
     <TextBlock x:Name="LastReadLabel" Grid.Column="2" Text="No text captured yet" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Row="3" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <CheckBox x:Name="AutoCopyInput" Content="Auto-copy to clipboard" Checked="AutoCopy_Changed" Unchecked="AutoCopy_Changed" ToolTip="Copy each new recognized result. Enabling also copies the current text. You can toggle this while capturing."/>
   <TextBlock x:Name="ClipboardStatusLabel" Grid.Column="1" Text="Off" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,8,0,0"/>
  </Grid>
  <Expander x:Name="SettingsExpander" Grid.Row="4" Header="Settings" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14">
   <Grid x:Name="SettingsPanel" Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Interval (ms)" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox x:Name="IntervalInput" Text="200" AutomationProperties.Name="Capture interval in milliseconds"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="OCR language" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="LanguageInput" DisplayMemberPath="Display" SelectionChanged="Language_Changed" AutomationProperties.Name="OCR language"/></StackPanel>
    <StackPanel Grid.Column="4"><CheckBox x:Name="PreprocessInput" Content="Enhance image for OCR" ToolTip="Extra grayscale and contrast correction. Small regions are enlarged automatically, even when this is off."/></StackPanel>
   </Grid>
  </Expander>
  <Grid Grid.Row="5" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="StartButton" Content="Start Capture" Click="Start_Click" Background="{StaticResource AccentBrush}" Foreground="#10241F" BorderBrush="{StaticResource AccentBrush}" IsEnabled="False" MinWidth="120"/>
   <Button x:Name="PauseButton" Grid.Column="1" Content="Pause" Click="Pause_Click" IsEnabled="False" Margin="10,0,0,0"/>
   <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="Stop_Click" IsEnabled="False" Margin="10,0,0,0"/>
   <StackPanel Grid.Column="4" Orientation="Horizontal"><Button x:Name="CopyButton" Content="Copy Text" Click="Copy_Click" IsEnabled="False" Margin="0,0,10,0" ToolTip="Copy the recognized text to the clipboard."/><Button Content="Sample Text" Click="SampleText_Click" ToolTip="Open a small sample source to try screen text recognition."/></StackPanel>
  </Grid>
  <Border Grid.Row="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel>
   <TextBlock x:Name="StatusLabel" Text="Select a source region to get started. Text is captured into this window." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
   <TextBlock x:Name="HotkeyLabel" Text="Emergency stop: Ctrl + Alt + Shift + S   ·   Keep the source visible and unobstructed." Margin="0,7,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
  </StackPanel></Border>
 </Grid>
 </ScrollViewer>
 </Grid>
</Window>
